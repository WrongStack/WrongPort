{
  "name": "wrongport",
  "version": "0.2.1",
  "description": "Inspect dev servers and their ports — list, watch, and kill processes from the CLI or a small web UI.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "web-dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wrongport": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev:web": "vite",
    "dev:api": "tsx watch src/cli/index.ts serve",
    "wrongport": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js serve --open",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test:coverage && npm run build",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "commander": "^15.0.0",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
